# =====================================================
# AJNC — environment variables
# Copy to your Netlify site settings (Site configuration > Environment
# variables). Do NOT commit a real .env with secrets.
# =====================================================

# --- AI assistant (server-side only; never exposed to the browser) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional model override (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Supabase & Formspree ---
# These are PUBLIC values and live in assets/config.js (or are injected at
# build time), not here. Listed for reference:
#   SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_ANON_KEY=eyJhbGciOi...
#   FORMSPREE_PRAYER_ID=xxxxxxx
#   FORMSPREE_NEWSLETTER_ID=xxxxxxx
